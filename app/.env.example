# Configuración del entorno Supabase para el frontend (Vite)
# En desarrollo local:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# En producción (Vercel):
# Configurar estas variables en la consola de Vercel (Project Settings > Environment Variables):
VITE_SUPABASE_URL=https://<TU-PROYECTO>.supabase.co
VITE_SUPABASE_ANON_KEY=<TU-ANON-KEY-PUBLICA>

# NOTA DE SEGURIDAD:
# La clave `service_role` NUNCA debe incluirse en este archivo ni exponerse en el frontend.
# Solo se utiliza en el entorno seguro de ejecución de las Edge Functions de Supabase.
